<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="GlassInk" Color="#F1F4F8"/>
    <SolidColorBrush x:Key="GlassMuted" Color="#B1BAC8"/>
    <SolidColorBrush x:Key="GlassAccent" Color="#B9D7FF"/>
    <SolidColorBrush x:Key="GlassPlate" Color="#0CFFFFFF"/>
    <SolidColorBrush x:Key="GlassLine" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="GlassHover" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="GlassSelected" Color="#284A8DDF"/>
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource GlassInk}"/>
        <Setter Property="Background" Value="{DynamicResource GlassPlate}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Plate" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="{DynamicResource GlassHover}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Background" Value="{DynamicResource GlassSelected}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource GlassAccent}"/><Setter TargetName="Plate" Property="BorderThickness" Value="1"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource GlassInk}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource GlassAccent}"/>
        <Setter Property="SelectionBrush" Value="#557DB7"/>
        <Setter Property="Background" Value="{DynamicResource GlassPlate}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Plate" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource GlassMuted}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource GlassAccent}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource GlassInk}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Plate" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="{DynamicResource GlassHover}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Plate" Property="Background" Value="{DynamicResource GlassSelected}"/><Setter TargetName="Plate" Property="BorderBrush" Value="#305F9BD9"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource GlassAccent}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#506F7B8D" CornerRadius="3" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource GlassInk}"/>
        <Setter Property="Background" Value="{DynamicResource GlassPlate}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource GlassPlate}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" CornerRadius="7"/></ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="10,8,30,8" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{DynamicResource GlassMuted}" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="#F2242B36" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280">
                                <ScrollViewer><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource GlassInk}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Plate" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Plate" Property="Background" Value="{DynamicResource GlassHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Plate" Property="Background" Value="{DynamicResource GlassSelected}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource WinDockSmoothContextMenu}"/>
    <Style TargetType="MenuItem" BasedOn="{StaticResource WinDockSmoothMenuItem}"/>
</ResourceDictionary>
