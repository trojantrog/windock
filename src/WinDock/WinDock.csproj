<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WinDock</AssemblyName>
    <RootNamespace>WinDock</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <StartupObject>WinDock.Program</StartupObject>
    <Version>0.6.0-preview.4</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>WinDock</Product>
    <Company>Breno Alvim</Company>
    <Description>A dock for Windows with environments, widgets and a magnifying lens</Description>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="Presets\*.json" LogicalName="Presets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Localization\zh-CN.json" LogicalName="WinDock.Localization.zh-CN.json" />
    <EmbeddedResource Include="Localization\en-tools.json" LogicalName="WinDock.Localization.en-tools.json" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\native\WinDock.TrayHook\bin\win-x64\WinDock.TrayHook.x64.dll')">
    <Content Include="..\..\native\WinDock.TrayHook\bin\win-x64\WinDock.TrayHook.x64.dll" Link="WinDock.TrayHook.x64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\native\WinDock.TrayHook\bin\win-x64\WinDock.TrayHook.x64.dll.sha256" Link="WinDock.TrayHook.x64.dll.sha256" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\third_party\YASB-LICENSE.txt" Link="licenses\YASB-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
