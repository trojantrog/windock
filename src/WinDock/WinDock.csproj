<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WinDock</AssemblyName>
    <RootNamespace>WinDock</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <StartupObject>WinDock.Program</StartupObject>
    <Version>0.6.0-preview.11</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>WinDock</Product>
    <Company>Breno Alvim</Company>
    <Description>A dock for Windows with environments, widgets and a magnifying lens</Description>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <Content Include="..\..\LICENSE" Link="licenses\WinDock-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.txt" Link="licenses\THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\docs\native-window-animation.md" Link="整窗动画说明.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\docs\popup-interactions.md" Link="托盘与菜单说明.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\docs\tray-compatibility.md" Link="托盘兼容说明.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="Presets\*.json" LogicalName="Presets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Localization\zh-CN.json" LogicalName="WinDock.Localization.zh-CN.json" />
    <EmbeddedResource Include="Localization\en-tools.json" LogicalName="WinDock.Localization.en-tools.json" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\native\WinDock.TrayHook\bin\win-x64\WinDock.TrayHook.x64.dll')">
    <Content Include="..\..\native\WinDock.TrayHook\bin\win-x64\WinDock.TrayHook.x64.dll" Link="WinDock.TrayHook.x64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\native\WinDock.TrayHook\bin\win-x64\WinDock.TrayHook.x64.dll.sha256" Link="WinDock.TrayHook.x64.dll.sha256" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\third_party\YASB-LICENSE.txt" Link="licenses\YASB-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\native\WinDock.Motion\bin\win-x64\WinDock.Motion.manifest.json')">
    <Content Include="..\..\native\WinDock.Motion\bin\win-x64\WinDock.Motion.x64.dll" Link="WinDock.Motion.x64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\native\WinDock.Motion\bin\win-x64\WinDock.MotionHost.exe" Link="WinDock.MotionHost.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\native\WinDock.Motion\bin\win-x64\WinDock.Motion.manifest.json" Link="WinDock.Motion.manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\third_party\minhook\LICENSE.txt" Link="licenses\MinHook-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <Target Name="RequireNativeMotionForRelease" BeforeTargets="PrepareForPublish" Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' == 'win-x64'">
    <Error Condition="!Exists('..\..\native\WinDock.Motion\bin\win-x64\WinDock.Motion.manifest.json')" Text="Build native/WinDock.Motion with build.ps1 before publishing." />
  </Target>

</Project>
