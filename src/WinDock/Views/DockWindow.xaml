<Window x:Class="WinDock.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:v="clr-namespace:WinDock.Views"
        xmlns:vm="clr-namespace:WinDock.ViewModels"
        Title="WinDock Dock"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        Width="900" Height="170" Left="-32000" Top="-32000" AllowDrop="True" Focusable="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource DockFont}">

    <Window.Resources>
        <sys:Double x:Key="IconSize">46</sys:Double>
        <sys:Double x:Key="WideSize">100</sys:Double>
        <sys:Double x:Key="WiderSize">154</sys:Double>
        <SolidColorBrush x:Key="DockLine" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="DotIdle" Color="#59FFFFFF"/>
        <SolidColorBrush x:Key="TileFace" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="DockInk" Color="#F4EFE7"/>
        <SolidColorBrush x:Key="DockMuted" Color="#B3F4EFE7"/>
        <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <sys:Double x:Key="WidgetHeight">46</sys:Double>
        <SolidColorBrush x:Key="WidgetSurface" Color="#EB252934"/>
        <SolidColorBrush x:Key="WidgetBorder" Color="#40FFFFFF"/>

        <Style x:Key="TileRoot" TargetType="Grid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="{DynamicResource IconSize}"/>
            <EventSetter Event="MouseEnter" Handler="OnTileEnter"/>
            <EventSetter Event="MouseLeave" Handler="OnTileLeave"/>
            <EventSetter Event="MouseDown" Handler="OnTileDown"/>
            <EventSetter Event="MouseUp" Handler="OnTileUp"/>
            <EventSetter Event="MouseWheel" Handler="OnTileWheel"/>
            <EventSetter Event="Loaded" Handler="OnTileLoaded"/>
        </Style>

        <Style x:Key="SystemSpot" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TileFace}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CompactWidget">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource IconSize}" ToolTip="{Binding Face.Tip}">
                <Border x:Name="Plate" CornerRadius="10" Background="{DynamicResource WidgetSurface}" BorderBrush="{DynamicResource WidgetBorder}" BorderThickness="1"/>
                <Border CornerRadius="13" Visibility="{Binding Face.HasImage, Converter={StaticResource Show}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Face.Image}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <Ellipse Margin="4" Stroke="{DynamicResource DockLine}" StrokeThickness="2.4" Visibility="{Binding Face.HasRing, Converter={StaticResource Show}}"/>
                <v:RingArc x:Name="Outer" Margin="4" Progress="{Binding Face.Ring}" Stroke="{DynamicResource DockInk}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                           Visibility="{Binding Face.HasRing, Converter={StaticResource Show}}"/>
                <Ellipse Margin="10" Stroke="{DynamicResource DockLine}" StrokeThickness="2.4" Visibility="{Binding Face.HasInnerRing, Converter={StaticResource Show}}"/>
                <v:RingArc Margin="10" Progress="{Binding Face.InnerRing}" Stroke="{Binding Face.InnerTint}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                           Visibility="{Binding Face.HasInnerRing, Converter={StaticResource Show}}"/>
                <Border CornerRadius="13" Background="{DynamicResource WidgetSurface}" Visibility="{Binding Face.HasPaper, Converter={StaticResource Show}}">
                    <TextBlock Text="{Binding Face.Paper}" FontFamily="{StaticResource DockFont}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource DockInk}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="9.5" LineStackingStrategy="BlockLineHeight"
                               Margin="5,5,4,5" VerticalAlignment="Center"/>
                </Border>
                <Grid VerticalAlignment="Bottom" Height="2.5" Margin="8,0,8,5" Visibility="{Binding Face.HasBar, Converter={StaticResource Show}}">
                    <Border CornerRadius="1.25" Background="#66FFFFFF"/>
                    <Border CornerRadius="1.25" Background="White" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Face.Bar}"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <Viewbox x:Name="Content" Margin="4" StretchDirection="DownOnly">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Face.Glyph}" FontFamily="{StaticResource Glyphs}" FontSize="15" Foreground="{DynamicResource DockInk}" HorizontalAlignment="Center"
                                   Visibility="{Binding Face.HasGlyph, Converter={StaticResource Show}}"/>
                        <TextBlock Text="{Binding Face.Symbol}" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="{DynamicResource DockInk}" HorizontalAlignment="Center"
                                   Visibility="{Binding Face.HasSymbol, Converter={StaticResource Show}}"/>
                        <TextBlock Text="{Binding Face.Value}" FontFamily="{StaticResource DockFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource DockInk}" HorizontalAlignment="Center"
                                   Visibility="{Binding Face.HasValue, Converter={StaticResource Show}}"/>
                        <TextBlock Text="{Binding Face.Caption}" FontFamily="{StaticResource DockFont}" FontSize="8" Foreground="{DynamicResource DockMuted}" HorizontalAlignment="Center"
                                   MaxWidth="44" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Visibility="{Binding Face.HasCaption, Converter={StaticResource Show}}"/>
                    </StackPanel>
                </Viewbox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Face.HasRing}" Value="True">
                    <Setter TargetName="Content" Property="Margin" Value="7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Face.Alert}" Value="True">
                    <Setter TargetName="Plate" Property="Background" Value="#E6E5483B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Face.HasTint}" Value="True">
                    <Setter TargetName="Outer" Property="Stroke" Value="{Binding Face.Tint}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Face.Dim}" Value="True">
                    <Setter TargetName="Content" Property="Opacity" Value="0.5"/>
                    <Setter TargetName="Outer" Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ClusterSpot" TargetType="Border" BasedOn="{StaticResource SystemSpot}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="WidgetRoot" TargetType="Grid" BasedOn="{StaticResource TileRoot}">
            <Setter Property="Height" Value="{DynamicResource WidgetHeight}"/>
            <Setter Property="Width" Value="{DynamicResource WideSize}"/>
        </Style>

        <Style x:Key="WidgetFace" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WidgetSurface}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="WidgetValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DockFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource DockInk}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <Style x:Key="WidgetCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DockFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource DockMuted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:AppTile}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource IconSize}">
                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasIcon, Converter={StaticResource Show}}"/>
                <Border CornerRadius="12" Background="{DynamicResource TileFace}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Display}" FontSize="16"
                               Foreground="{DynamicResource DockInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" MinWidth="17" Height="17"
                        CornerRadius="8.5" Background="#FF453A" Padding="4,0" BorderBrush="#40000000" BorderThickness="1"
                        Visibility="{Binding HasBadge, Converter={StaticResource Show}}">
                    <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SeparatorTile}">
            <Grid Width="11" Height="{DynamicResource IconSize}">
                <Rectangle Width="1" Margin="0,7" Fill="{DynamicResource DockLine}" HorizontalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StartTile}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource IconSize}" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                <Viewbox Margin="4">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#168BEB" Data="M1,1 H11 V11 H1 Z M13,1 H23 V11 H13 Z M1,13 H11 V23 H1 Z M13,13 H23 V23 H13 Z"/>
                    </Canvas>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:UtilityTile}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource IconSize}" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                <Viewbox Margin="4">
                    <Canvas Width="24" Height="24">
                        <Path Data="{Binding IconPath}" Stroke="{DynamicResource DockInk}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SystemTile}">
            <StackPanel Orientation="Horizontal" Height="{DynamicResource IconSize}">
                <Border Background="Transparent" Width="{DynamicResource IconSize}" Cursor="Hand" ToolTip="{Binding TrayTip}" MouseLeftButtonUp="OnTrayClick">
                    <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Glyphs}" FontSize="17" Foreground="{DynamicResource DockInk}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <Border CornerRadius="9" Margin="2,1,2,1" Padding="0" Background="{DynamicResource TileFace}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource ClusterSpot}" Width="{DynamicResource IconSize}" ToolTip="{Binding NetworkTip}" MouseLeftButtonUp="OnStatusClick">
                            <Viewbox Margin="4"><TextBlock Text="{Binding NetworkGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="24" Foreground="{DynamicResource DockInk}"/></Viewbox>
                        </Border>
                        <Border Style="{StaticResource ClusterSpot}" Width="{DynamicResource IconSize}" ToolTip="{Binding VolumeTip}" MouseUp="OnVolumeClick" MouseWheel="OnVolumeWheel">
                            <Viewbox Margin="4"><TextBlock Text="{Binding VolumeGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="24" Foreground="{DynamicResource DockInk}"/></Viewbox>
                        </Border>
                        <Border Style="{StaticResource ClusterSpot}" Width="{DynamicResource IconSize}" ToolTip="{Binding MicTip}" MouseLeftButtonUp="OnMicClick"
                                Visibility="{Binding HasMic, Converter={StaticResource Show}}">
                            <Viewbox Margin="4"><TextBlock x:Name="MicIcon" Text="{Binding MicGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="24" Foreground="{DynamicResource DockInk}"/></Viewbox>
                        </Border>
                        <Border Style="{StaticResource ClusterSpot}" Width="{DynamicResource IconSize}" ToolTip="{Binding BatteryTip}" MouseLeftButtonUp="OnStatusClick"
                                Visibility="{Binding HasBattery, Converter={StaticResource Show}}">
                            <Viewbox Margin="4"><TextBlock Text="{Binding BatteryGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="24" Foreground="{DynamicResource DockInk}"/></Viewbox>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SystemSpot}" Padding="8,0,8,0" ToolTip="{Binding ClockTip}" MouseLeftButtonUp="OnClockClick">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Time}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource DockInk}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Date}" FontSize="11.5" Foreground="{DynamicResource DockMuted}" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="9" Margin="3,7,0,7" Background="Transparent" Cursor="Hand" ToolTip="{Binding DesktopTip}" MouseLeftButtonUp="OnDesktopClick">
                    <Rectangle Width="1" Fill="{DynamicResource DockLine}" HorizontalAlignment="Right"/>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding MicMuted}" Value="True">
                    <Setter TargetName="MicIcon" Property="Foreground" Value="#FF5A4E"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ReadableWidget">
            <Grid Style="{StaticResource WidgetRoot}" MinWidth="{Binding Presentation.MinWidth}"
                  ToolTip="{Binding Presentation.Tip}" AutomationProperties.Name="{Binding Presentation.Tip}">
                <Border x:Name="Face" Style="{StaticResource WidgetFace}"/>
                <Grid x:Name="Content">
                    <Grid x:Name="Single" Margin="9,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding Presentation.HasMarker, Converter={StaticResource Show}}">
                            <TextBlock Text="{Binding Presentation.Glyph}" FontFamily="{StaticResource Glyphs}" FontSize="18"
                                       Foreground="{DynamicResource DockInk}" Visibility="{Binding Presentation.HasGlyph, Converter={StaticResource Show}}"/>
                            <TextBlock Text="{Binding Presentation.Symbol}" FontFamily="Segoe UI Symbol" FontSize="21"
                                       Foreground="{DynamicResource DockInk}" Visibility="{Binding Presentation.HasSymbol, Converter={StaticResource Show}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Presentation.Value}" Style="{StaticResource WidgetValue}"/>
                            <TextBlock Text="{Binding Presentation.Caption}" Style="{StaticResource WidgetCaption}"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="Dual" Margin="9,3" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="13"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Presentation.Value}" Style="{StaticResource WidgetValue}"/>
                            <TextBlock Text="{Binding Presentation.Caption}" Style="{StaticResource WidgetCaption}"/>
                        </StackPanel>
                        <Rectangle Grid.Column="1" Width="1" Margin="0,6" Fill="{DynamicResource DockLine}"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Presentation.SecondValue}" Style="{StaticResource WidgetValue}"/>
                            <TextBlock Text="{Binding Presentation.SecondCaption}" Style="{StaticResource WidgetCaption}"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="Tracks" Margin="9,0,9,3" Height="2" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="TrackGap" Width="0"/>
                            <ColumnDefinition x:Name="SecondTrack" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Grid Visibility="{Binding Presentation.HasProgress, Converter={StaticResource Show}}">
                            <Border CornerRadius="1" Background="{DynamicResource DockLine}"/>
                            <Border CornerRadius="1" Background="{DynamicResource DockInk}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="{Binding Presentation.Progress}"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <Grid Grid.Column="2" Visibility="{Binding Presentation.HasSecondProgress, Converter={StaticResource Show}}">
                            <Border CornerRadius="1" Background="{DynamicResource DockLine}"/>
                            <Border CornerRadius="1" Background="{DynamicResource DockInk}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform ScaleX="{Binding Presentation.SecondProgress}"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="Paper" Text="{Binding Presentation.Paper}" Style="{StaticResource WidgetCaption}"
                               Foreground="{DynamicResource DockInk}" TextWrapping="Wrap" MaxHeight="30" LineHeight="14"
                               LineStackingStrategy="BlockLineHeight" Margin="9,4" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Presentation.Dual}" Value="True">
                    <Setter TargetName="Single" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Dual" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="TrackGap" Property="Width" Value="13"/>
                    <Setter TargetName="SecondTrack" Property="Width" Value="*"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Presentation.HasPaper}" Value="True">
                    <Setter TargetName="Single" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Paper" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Presentation.Alert}" Value="True">
                    <Setter TargetName="Face" Property="BorderBrush" Value="#E6E5483B"/>
                    <Setter TargetName="Face" Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Presentation.Dim}" Value="True">
                    <Setter TargetName="Content" Property="Opacity" Value="0.65"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="MusicPause">
            <Grid Style="{StaticResource WidgetRoot}" Width="{DynamicResource WideSize}" MinWidth="192"
                  ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                <Border Style="{StaticResource WidgetFace}"/>
                <Grid Margin="7,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource TileFace}" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Glyphs}" FontSize="16" Foreground="{DynamicResource DockInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="6" Visibility="{Binding HasCover, Converter={StaticResource Show}}">
                                <Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/></Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,7,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource WidgetValue}" FontSize="11.5" Foreground="{DynamicResource DockInk}"/>
                        <TextBlock Text="{Binding Artist}" Style="{StaticResource WidgetCaption}" Foreground="{DynamicResource DockMuted}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Idle}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Background="Transparent" Cursor="Hand" Width="24" Height="28" MouseUp="OnMediaToggle">
                            <TextBlock Text="{Binding ToggleGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="14" Foreground="{DynamicResource DockInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
                <Grid Height="2" Margin="45,0,38,3" VerticalAlignment="Bottom" Visibility="{Binding HasProgress, Converter={StaticResource Show}}">
                    <Border CornerRadius="1" Background="{DynamicResource DockLine}"/>
                    <Border CornerRadius="1" Background="{DynamicResource DockInk}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="{Binding Progress}"/></Border.RenderTransform>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MusicFull">
            <Grid Style="{StaticResource WidgetRoot}" Width="{DynamicResource WiderSize}" MinWidth="256"
                  ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                <Border Style="{StaticResource WidgetFace}"/>
                <Grid Margin="7,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource TileFace}" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Glyphs}" FontSize="16" Foreground="{DynamicResource DockInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="6" Visibility="{Binding HasCover, Converter={StaticResource Show}}">
                                <Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/></Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,7,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource WidgetValue}" FontSize="11.5" Foreground="{DynamicResource DockInk}"/>
                        <TextBlock Text="{Binding Artist}" Style="{StaticResource WidgetCaption}" Foreground="{DynamicResource DockMuted}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Idle}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Background="Transparent" Cursor="Hand" Width="24" Height="28" MouseUp="OnMediaPrevious">
                            <TextBlock Text="&#xE892;" FontFamily="{StaticResource Glyphs}" FontSize="12" Foreground="{DynamicResource DockInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="Transparent" Cursor="Hand" Width="24" Height="28" MouseUp="OnMediaToggle">
                            <TextBlock Text="{Binding ToggleGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="14" Foreground="{DynamicResource DockInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="Transparent" Cursor="Hand" Width="24" Height="28" MouseUp="OnMediaNext">
                            <TextBlock Text="&#xE893;" FontFamily="{StaticResource Glyphs}" FontSize="12" Foreground="{DynamicResource DockInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
                <Grid Height="2" Margin="45,0,86,3" VerticalAlignment="Bottom" Visibility="{Binding HasProgress, Converter={StaticResource Show}}">
                    <Border CornerRadius="1" Background="{DynamicResource DockLine}"/>
                    <Border CornerRadius="1" Background="{DynamicResource DockInk}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="{Binding Progress}"/></Border.RenderTransform>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MusicBackdrop">
            <Grid Style="{StaticResource WidgetRoot}" Width="{DynamicResource WiderSize}" MinWidth="256"
                  ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                <Border Style="{StaticResource WidgetFace}"/>
                <Border CornerRadius="10" Visibility="{Binding HasCover, Converter={StaticResource Show}}">
                    <Border.Background><ImageBrush ImageSource="{Binding Backdrop}" Stretch="Fill"/></Border.Background>
                </Border>
                <Border CornerRadius="10" Background="#D9252934"/>
                <Grid Margin="7,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource TileFace}" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Glyphs}" FontSize="16" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="6" Visibility="{Binding HasCover, Converter={StaticResource Show}}">
                                <Border.Background><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/></Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,7,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource WidgetValue}" FontSize="11.5" Foreground="White"/>
                        <TextBlock Text="{Binding Artist}" Style="{StaticResource WidgetCaption}" Foreground="#E6FFFFFF"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Idle}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Background="Transparent" Cursor="Hand" Width="24" Height="28" MouseUp="OnMediaPrevious">
                            <TextBlock Text="&#xE892;" FontFamily="{StaticResource Glyphs}" FontSize="12" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="Transparent" Cursor="Hand" Width="24" Height="28" MouseUp="OnMediaToggle">
                            <TextBlock Text="{Binding ToggleGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="Transparent" Cursor="Hand" Width="24" Height="28" MouseUp="OnMediaNext">
                            <TextBlock Text="&#xE893;" FontFamily="{StaticResource Glyphs}" FontSize="12" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
                <Grid Height="2" Margin="45,0,86,3" VerticalAlignment="Bottom" Visibility="{Binding HasProgress, Converter={StaticResource Show}}">
                    <Border CornerRadius="1" Background="{DynamicResource DockLine}"/>
                    <Border CornerRadius="1" Background="White" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="{Binding Progress}"/></Border.RenderTransform>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <v:FaceSelector x:Key="Faces" Compact="{StaticResource CompactWidget}" Readable="{StaticResource ReadableWidget}"
                        MusicPause="{StaticResource MusicPause}" MusicFull="{StaticResource MusicFull}" MusicBackdrop="{StaticResource MusicBackdrop}"/>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Grid.RenderTransform>

        <ItemsControl x:Name="Strip" ItemsSource="{Binding Tiles}" Margin="0,0,0,6" Focusable="False" ItemTemplateSelector="{StaticResource Faces}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <v:LensPanel Loaded="OnPanelLoaded" MouseMove="OnPanelMove" MouseEnter="OnPanelEnter" MouseLeave="OnPanelLeave"
                                 MouseRightButtonUp="OnPanelMenu" MouseWheel="OnPanelWheel"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="v:LensPanel.Lens" Value="{Binding Lens}"/>
                    <Setter Property="v:LensPanel.Indicator" Value="{Binding Indicator}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <Canvas IsHitTestVisible="False">
            <Border x:Name="NameTag" CornerRadius="9" Padding="10,5" Opacity="0" Background="#EB1E2029"
                    BorderBrush="#26FFFFFF" BorderThickness="1">
                <TextBlock x:Name="NameText" FontSize="11.5" Foreground="#F4EFE7"/>
            </Border>
            <Border x:Name="Banner" CornerRadius="14" Padding="14,7" Opacity="0" BorderBrush="#40FFFFFF" BorderThickness="1">
                <TextBlock x:Name="BannerText" FontSize="12" FontWeight="Bold" Foreground="#101114"/>
            </Border>
        </Canvas>
        <Canvas>
            <Border x:Name="Toast" CornerRadius="11" Padding="12,5,6,5" Visibility="Collapsed" Background="#F21E2029" BorderBrush="#26FFFFFF" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastText" FontSize="11.5" Foreground="#F4EFE7" VerticalAlignment="Center"/>
                    <Border Margin="10,0,0,0" Padding="9,3" CornerRadius="8" Background="#26FFFFFF" Cursor="Hand" MouseLeftButtonUp="OnUndo">
                        <TextBlock x:Name="UndoText" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFB547"/>
                    </Border>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
